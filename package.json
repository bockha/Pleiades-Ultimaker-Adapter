{
  "name": "pleiades-ultimaker-adapter",
  "version": "0.2.0",
  "private": true,
  "description": "Publishes the operating data of an Ultimaker 3 to the MQTT broker of the Pleiades Playground, by the umati data model 0.17.1.",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node src/main.ts",
    "mock": "node test/mock-printer.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mqtt": "5.15.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.9.3"
  }
}
