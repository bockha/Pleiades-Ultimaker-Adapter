# Copy to .env and adjust. .env is not committed.

# Local API of the printer.
PRINTER_URL=http://192.168.100.27
# Identification.SerialNumber and Model. The machine id is ultimaker_<MODEL>_<SERIAL_NUMBER>,
# every topic lies below machines/<machine id>/ (model 0.17.1 of the MQTT binding).
SERIAL_NUMBER=UM3-01
MODEL=UM3
# Optional: the globally unique id. Empty: https://ultimaker.com/<MODEL>/<SERIAL_NUMBER>
PRODUCT_INSTANCE_URI=

# The broker. Local Playground stack on this computer: mqtt://host.docker.internal:1883
# The shared broker of the hackathon: the address Benjamin gives you, e.g. mqtt://<host>:1883
MQTT_URL=mqtt://host.docker.internal:1883
# DNS server for the container, needed when the broker has a LAN-only name (e.g. *.internal).
# Find it with: resolvectl dns
DNS_SERVER=8.8.8.8
MQTT_USER=
MQTT_PASSWORD=

# Optional, in seconds.
POLL_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=10
